generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------
// 1 & 2. ユーザーアカウント・セッション・設定連携
// ------------------------------------
model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  passwordHash  String?   // 独自認証用パスワード
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  settings            UserSettings?
  tasks               Task[]
  recurringTasks      RecurringTask[]
  notes               Note[]
  attachments         Attachment[]
  mailLogs            MailLog[]
  mailBlocklist       MailBlocklist[]
  backupConfigs       BackupConfig[]
  backupHistories     BackupHistory[]
  sharedFiles         SharedFile[]
  asyncJobs           AsyncJob[]
}

// OAuth アカウントリンク用
model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

// セッション管理用
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ユーザー単位の設定 (AI連携・通知設定等)
model UserSettings {
  id                     String  @id @default(uuid())
  userId                 String  @unique
  aiProvider             String  @default("openai") // openai, gemini, anthropic など
  aiApiKeyEncoded        String? // 暗号化されたAPIキー
  aiModelPreference      String? // gpt-4o, claude-3.5-sonnet 等
  discordWebhookUrl      String? // エラーや通知送信先
  pushoverUserKey        String? // モバイルプッシュ等外部通知用

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 3. タスク管理
// ------------------------------------
model Task {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  progress    Int       @default(0) // 進捗率 0-100等
  priority    Int       @default(0) // 優先度 (例: 0=なし, 1=低, 2=中, 3=高)
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklist     ChecklistItem[]
  alarms        AlarmNotification[]
}

model ChecklistItem {
  id          String   @id @default(uuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  orderIdx    Int      @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 4. 定期タスク管理
// ------------------------------------
model RecurringTask {
  id             String   @id @default(uuid())
  userId         String
  title          String
  description    String?
  cronExpression String   // 実行タイミング (例: 0 9 * * 1)
  isActive       Boolean  @default(true) // 有効・無効（一時停止）フラグ
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates  RecurringTemplate[]
}

model RecurringTemplate {
  id              String   @id @default(uuid())
  recurringTaskId String
  title           String
  orderIdx        Int      @default(0)

  recurringTask RecurringTask @relation(fields: [recurringTaskId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 6. アラーム・通知管理
// ------------------------------------
model AlarmNotification {
  id             String   @id @default(uuid())
  taskId         String?
  scheduledFor   DateTime // 発火予定日時
  message        String?
  isSent         Boolean  @default(false)
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

// ------------------------------------
// 7. ノート（メモ）機能
// ------------------------------------
model Note {
  id           String    @id @default(uuid())
  userId       String
  title        String
  content      String    // Markdown等の本文
  thumbnailUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // 論理削除

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
}

// ------------------------------------
// 8. 添付ファイル管理
// ------------------------------------
model Attachment {
  id           String   @id @default(uuid())
  userId       String
  noteId       String?
  filePath     String   // upload/xxx.png 等
  fileName     String
  fileSize     Int
  mimeType     String
  createdAt    DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note? @relation(fields: [noteId], references: [id], onDelete: SetNull)
}

// ------------------------------------
// 9. メール要約およびフィルタリング
// ------------------------------------
model MailLog {
  id             String   @id @default(uuid())
  userId         String
  sender         String
  subject        String
  receivedAt     DateTime
  summaryResult  String?
  status         String   @default("UNREAD") // UNREAD, PROCESSING, SUCCESS, FAILED
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MailBlocklist {
  id        String   @id @default(uuid())
  userId    String
  sender    String   // ブロック対象のアドレスやドメイン
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, sender])
}

// ------------------------------------
// 10. 外部ストレージバックアップ設定
// ------------------------------------
model BackupConfig {
  id                  String   @id @default(uuid())
  userId              String   @unique
  provider            String   @default("gdrive")
  targetFolderId      String?
  credentialsEncoded  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BackupHistory {
  id           String   @id @default(uuid())
  userId       String
  status       String   // SUCCESS, FAILED
  errorMessage String?
  executedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 11. 一時ファイル共有
// ------------------------------------
model SharedFile {
  id            String   @id @default(uuid())
  userId        String
  attachmentId  String   // 該当する Attachment の ID
  shareToken    String   @unique
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 12. 非同期ジョブ（バックグラウンド処理）の追跡
// ------------------------------------
model AsyncJob {
  id          String   @id @default(uuid())
  userId      String
  type        String   // AI_GENERATION, BACKUP, MAIL_SUMMARY 等
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress    Int      @default(0) // 0 - 100
  resultData  String?  // JSON文字列等
  errorDetail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 13. システム全体のグローバル設定
// ------------------------------------
model SystemGlobalConfig {
  id        String   @id @default("global") // 常に1レコード想定
  key       String   @unique
  value     String   // 文字列化されたデータ (例: '3145728000' (3GB))
  updatedAt DateTime @updatedAt
}
